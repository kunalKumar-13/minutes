# Copy to backend/.env and edit as needed. Every value has a working default.

# SQLite by default; any SQLAlchemy URL works, though the FTS5 search index is
# SQLite-specific and degrades to a LIKE scan elsewhere.
DATABASE_URL=sqlite:///./fireflies.db

# Browser origins allowed to call the API. *.vercel.app is always permitted.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Seed the sample workspace on first boot when the database is empty.
AUTO_SEED=true

# Optional. With a key, meeting notes and "ask this meeting" are generated by
# Claude. Without one, the built-in extractive summariser is used instead —
# the app is fully functional either way.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5
